{
  "manifest_version": 3,

  "name": "Job Application Tracker",

  "version": "2.1.0",

  "description": "Automatically tracks JobStreet job applications and saves them to Google Sheets.",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://id.jobstreet.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://id.jobstreet.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "service_worker": "background.js"
  }
}